{
  "resources": [
    {
      "type": "Microsoft.App/containerApps",
      "name": "aca-hardened-app",
      "identity": {
        "type": "UserAssigned"
      },
      "properties": {
        "configuration": {
          "ingress": {
            "external": false,
            "targetPort": 8080,
            "transport": "http",
            "ipSecurityRestrictions": [
              {
                "name": "allow-app-vnet",
                "action": "Allow",
                "ipAddressRange": "10.0.0.0/8"
              }
            ],
            "ipSecurityRestrictionsDefaultAction": "Deny"
          },
          "secrets": [
            {
              "name": "db-password",
              "keyVaultUrl": "https://acahardened0000000000000.vault.azure.net/secrets/DbPassword"
            }
          ]
        },
        "template": {
          "containers": [
            {
              "name": "hello",
              "image": "acahardened0000000000000.azurecr.io/hello:1.0.0",
              "env": [
                {
                  "name": "DB_PASSWORD",
                  "secretRef": "db-password"
                }
              ]
            }
          ],
          "scale": {
            "minReplicas": 1,
            "maxReplicas": 2
          }
        }
      }
    },
    {
      "type": "Microsoft.Authorization/roleAssignments",
      "name": "00000000-0000-0000-0000-000000000002",
      "scope": "/subscriptions/00000000-0000-0000-0000-000000000000/resourceGroups/rg-aca-hardened/providers/Microsoft.ContainerRegistry/registries/acahardened0000000000000",
      "properties": {
        "roleDefinitionId": "/subscriptions/00000000-0000-0000-0000-000000000000/providers/Microsoft.Authorization/roleDefinitions/7f951dda-4ed3-4680-a7ca-43fe172d538d",
        "principalType": "ServicePrincipal"
      }
    },
    {
      "type": "Microsoft.Authorization/roleAssignments",
      "name": "00000000-0000-0000-0000-000000000003",
      "scope": "/subscriptions/00000000-0000-0000-0000-000000000000/resourceGroups/rg-aca-hardened/providers/Microsoft.KeyVault/vaults/acahardened0000000000000",
      "properties": {
        "roleDefinitionId": "/subscriptions/00000000-0000-0000-0000-000000000000/providers/Microsoft.Authorization/roleDefinitions/4633458b-17de-408a-b874-0445c86b69e6",
        "principalType": "ServicePrincipal"
      }
    }
  ]
}