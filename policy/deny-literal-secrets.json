{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "policyName": {
      "type": "string",
      "defaultValue": "deny-aca-literal-secrets"
    },
    "effect": {
      "type": "string",
      "defaultValue": "deny",
      "allowedValues": [
        "deny",
        "audit"
      ]
    }
  },
  "resources": [
    {
      "type": "Microsoft.Authorization/policyDefinitions",
      "apiVersion": "2023-04-01",
      "name": "[parameters('policyName')]",
      "properties": {
        "displayName": "Deny literal secrets in Container Apps env vars",
        "description": "Denies Container Apps that set env var values inline. Secrets must come from Key Vault via keyVaultUrl + secretRef.",
        "metadata": "{\"category\":\"Container Apps\",\"version\":\"1.0.0\"}",
        "mode": "All",
        "policyRule": {
          "if": {
            "allOf": [
              {
                "field": "type",
                "equals": "Microsoft.App/containerApps"
              },
              {
                "field": "properties.template.containers[*].env[*].value",
                "exists": true
              }
            ]
          },
          "then": {
            "effect": "[parameters('effect')]"
          }
        }
      }
    },
    {
      "type": "Microsoft.Authorization/policyAssignments",
      "apiVersion": "2023-04-01",
      "name": "[concat(parameters('policyName'), '-assign')]",
      "properties": {
        "displayName": "Deny literal secrets in Container Apps env vars (assignment)",
        "enforcementMode": "Default",
        "policyDefinitionId": "[reference(resourceId('Microsoft.Authorization/policyDefinitions', parameters('policyName')), '2023-04-01').id]"
      }
    }
  ]
}
