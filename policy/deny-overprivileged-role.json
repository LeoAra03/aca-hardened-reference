{
  "properties": {
    "displayName": "Deny Contributor/Owner role assignments at resource group scope",
    "description": "Denies role assignments granting Contributor or Owner on a resource group. Workload identities get least-privilege roles (AcrPull, Key Vault Secrets User), never broad RG access.",
    "metadata": {
      "category": "Authorization",
      "version": "1.0.0"
    },
    "mode": "All",
    "rules": {
      "if": {
        "allOf": [
          {
            "field": "type",
            "equals": "Microsoft.Authorization/roleAssignments"
          },
          {
            "field": "scope",
            "like": "*resourceGroups*"
          },
          {
            "anyOf": [
              {
                "field": "properties.roleDefinitionId",
                "like": "*b2497c52-6040-4519-a36c-8a0f3c35f8d2*"
              },
              {
                "field": "properties.roleDefinitionId",
                "like": "*8e3af657-a8ff-443c-a75c-2fe8c4bcb635*"
              }
            ]
          }
        ]
      },
      "then": {
        "effect": "deny"
      }
    }
  }
}
